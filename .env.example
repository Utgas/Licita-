# Variáveis de ambiente do Licita+. Só os nomes; os valores ficam no
# .env.local (sua máquina), nas variáveis de ambiente da Vercel e, se
# preciso, nos segredos do GitHub Actions. Nunca faça commit de valores.
#
# Nenhuma variável usa o prefixo NEXT_PUBLIC_: o navegador não fala com o
# Supabase; login e consultas passam pelo servidor (CLAUDE.md, regra 10).

# Supabase > Project Settings > Data API > Project URL: só https://<ref>.supabase.co, sem /rest/v1/ no fim.
# (O sistema descarta qualquer caminho, mas guarde o endereço limpo.)
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# Só servidor e script criar-usuario. Ignora o RLS: nunca no navegador.
SUPABASE_SECRET_KEY=

# Supabase > Connect > Connection string > Transaction pooler (porta 6543)
# Usada pela aplicação (Drizzle).
DATABASE_URL=

# Supabase > Connect > Connection string > Session pooler (porta 5432)
# Só na sua máquina: script npm run criar-usuario. Não vai para a Vercel.
DATABASE_URL_MIGRACAO=

# Endereço público da aplicação, sem barra no fim. Vai no link do e-mail
# de redefinição de senha. Local: http://localhost:3000
APP_URL=
