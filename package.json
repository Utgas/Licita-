{
  "name": "licita-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "compilar": "node scripts/compilar-regras.ts",
    "compilar:piloto": "node scripts/compilar-regras.ts --piloto",
    "simular": "node scripts/simular-wizard.ts",
    "test:banco": "vitest run --config vitest.banco.config.ts",
    "criar-usuario": "node --env-file-if-exists=.env.local scripts/criar-usuario.ts",
    "test:telas": "playwright test"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "7.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
